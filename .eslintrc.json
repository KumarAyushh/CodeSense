{
  "root": true,
  "extends": "eslint:recommended",
  "env": {
    "node": true,
    "es2022": true
  },
  "parserOptions": {
    "ecmaVersion": 2022
  },
  "ignorePatterns": ["dist/", "scratch/"],
  "overrides": [
    {
      "files": ["media/**/*.js"],
      "env": {
        "node": false,
        "browser": true
      },
      "globals": {
        "acquireVsCodeApi": "readonly"
      }
    }
  ]
}
