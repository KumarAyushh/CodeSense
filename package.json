{
  "name": "codesense-ai",
  "displayName": "CodeSense AI - Code Reviewer & Assistant",
  "description": "AI-powered code reviewer with multi-provider support (Gemini, OpenAI). Get intelligent code suggestions, reviews, and automated fixes with visual diff comparisons.",
  "version": "1.0.8",
  "publisher": "KumarAyushh",
  "icon": "media/iconMain.png",
  "galleryBanner": {
    "color": "#1f4fd8",
    "theme": "dark"
  },
  "keywords": [
    "ai",
    "code-review",
    "gemini",
    "openai",
    "chatgpt",
    "assistant",
    "code-assistant",
    "refactoring",
    "diff",
    "code-quality"
  ],
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Programming Languages",
    "Machine Learning",
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "codesense.addApiKey",
        "title": "CodeSense: Add API Key"
      },
      {
        "command": "codesense.resetApiKey",
        "title": "CodeSense: Reset API Key"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "codesense-container",
          "title": "CodeSense AI",
          "icon": "media/codesense.svg"
        }
      ]
    },
    "views": {
      "codesense-container": [
        {
          "type": "webview",
          "id": "codesense.chatView",
          "name": "AI Chat",
          "icon": "media/codesense.svg"
        }
      ]
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/KumarAyushh/CodeSense.git"
  },
  "bugs": {
    "url": "https://github.com/KumarAyushh/CodeSense/issues"
  },
  "homepage": "https://github.com/KumarAyushh/CodeSense#readme",
  "scripts": {
    "lint": "eslint .",
    "bundle": "esbuild src/extension.js --bundle --platform=node --target=node16 --external:vscode --outfile=dist/extension.js",
    "build": "npm run bundle -- --sourcemap",
    "watch": "npm run bundle -- --sourcemap --watch",
    "vscode:prepublish": "npm run bundle -- --minify",
    "test": "node --test"
  },
  "dependencies": {
    "@google/genai": "^1.34.0",
    "openai": "^6.15.0"
  },
  "devDependencies": {
    "@types/vscode": "^1.80.0",
    "esbuild": "^0.28.2",
    "eslint": "^8.41.0"
  }
}
